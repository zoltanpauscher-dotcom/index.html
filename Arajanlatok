          <tbody>
            ${q.items.map(it => `
              <tr>
                <td class="item">
                  <div style="display:flex; align-items:center; gap:10px;">
                    ${it.image ? `<img src="${it.image}" style="width:40px; height:40px; object-fit:cover; border-radius:6px; flex-shrink:0;">` : ''}
                    <span>${Utils.escapeHtml(it.name)}</span>
                  </div>
                </td>
                <td class="r">${it.qty} ${Utils.escapeHtml(it.unit)}</td>
                <td class="r">${Utils.formatHuf(it.unitPrice)}</td>
                <td class="r">${Utils.formatHuf(it.qty * it.unitPrice)}</td>
              </tr>
            `).join('')}
          </tbody>
        </table>

        <div class="pdf-totals">
          <div class="pdf-totals-box">
            <div class="pdf-totals-row"><span>Nettó</span><span>${Utils.formatHuf(t.net)}</span></div>
            <div class="pdf-totals-row"><span>Áfa (${q.vatRate}%)</span><span>${Utils.formatHuf(t.vat)}</span></div>
            <div class="pdf-totals-row grand"><span>Bruttó</span><span>${Utils.formatHuf(t.gross)}</span></div>
          </div>
        </div>

        ${q.note ? `<div class="pdf-note"><b>Megjegyzés:</b> ${Utils.escapeHtml(q.note)}</div>` : ''}

        ${qrDataUrl ? `
        <div class="pdf-qr">
          <img src="${qrDataUrl}" alt="QR">
          <p>Szkenneld be a telefonoddal az árajánlat azonnali elfogadásához.</p>
        </div>
        ` : ''}

        <div class="pdf-footer">
          Az árajánlat ${Utils.formatDate(q.createdAt)}-án kelt. Érvényes: 30 nap.${c.name ? ' · ' + Utils.escapeHtml(c.name) : ''}${c.phone ? ' · ' + Utils.escapeHtml(c.phone) : ''}
        </div>
      </div>
    `;
    document.body.appendChild(doc);

    Toast.show('PDF generálás...');
    html2pdf().set({
      margin: 0,
      filename: `${q.number}_${(q.clientName || 'arajanlat').replace(/[^a-zA-Z0-9]/g, '_')}.pdf`,
      image: { type: 'jpeg', quality: 0.98 },
      html2canvas: { scale: 2, useCORS: true, backgroundColor: '#ffffff' },
      jsPDF: { unit: 'mm', format: 'a4', orientation: 'portrait' }
    }).from(doc).save().then(() => {
      document.body.removeChild(doc);
      Toast.show('PDF letöltve');
    }).catch(() => {
      document.body.removeChild(doc);
      Toast.show('Hiba a PDF generálásnál');
    });
  },

  /* ===== SHARE ===== */
  shareQuote(id) {
    const q = Store.quotes.find(x => x.id === id); if (!q) return;
    const t = Utils.calcTotals(q.items, q.vatRate);
    const c = Store.company;
    const payload = {
      number: q.number, clientName: q.clientName,
      companyName: c.name || 'Ajánlattevő', companyPhone: c.phone || '',
      items: q.items, vatRate: q.vatRate, note: q.note,
      createdAt: q.createdAt, totals: t, status: q.status
    };
    const encoded = Utils.b64encode(JSON.stringify(payload));
    const acceptUrl = window.location.origin + window.location.pathname + '#accept=' + encoded;
    const text = `${c.name || 'Ajánlat'} — ${q.number}\n\nKedves ${q.clientName}!\n\nKüldöm az árajánlatot: ${Utils.formatHuf(t.gross)} (bruttó).\n\nRészletek és elfogadás: ${acceptUrl}\n\nÜdvözlettel,\n${c.name || ''} ${c.phone || ''}`;

    if (navigator.share) {
      navigator.share({ title: 'Árajánlat — ' + q.number, text: text, url: acceptUrl }).catch(() => {});
    } else {
      navigator.clipboard.writeText(text)
        .then(() => Toast.show('Vágólapra másolva'))
        .catch(() => prompt('Másold ki:', text));
    }
  },

  /* ===== CLIENT ACCEPT VIEW ===== */
  renderAccept(p) {
    const t = p.totals;
    const itemsHtml = p.items.map(it => `
      <div class="line">
        ${it.image ? `<img src="${it.image}" class="line-img">` : ''}
        <div class="line-body">
          <div class="line-name">${Utils.escapeHtml(it.name)}</div>
          <div class="line-meta">${it.qty} ${Utils.escapeHtml(it.unit)} × ${Utils.formatHuf(it.unitPrice)}</div>
        </div>
        <div class="line-price">${Utils.formatHuf(it.qty * it.unitPrice)}</div>
      </div>
    `).join('');

    const phoneClean = (p.companyPhone || '').replace(/[^0-9]/g, '');
    const wa = (msg) => phoneClean ? `https://wa.me/${phoneClean}?text=${encodeURIComponent(msg)}` : `https://wa.me/?text=${encodeURIComponent(msg)}`;
    const acceptMsg = `Kedves ${p.companyName}! Elfogadom a ${p.number} számú árajánlatot (${Utils.formatHuf(t.gross)}).`;
    const declineMsg = `Kedves ${p.companyName}! Köszönöm, de a ${p.number} számú árajánlatot nem tudom elfogadni.`;

    document.getElementById('app').innerHTML = `
      ${Layout.header(p.number, p.companyName)}
      <div class="container">
        <div class="hero fade-in">
          <div class="hero-inner">
            <div class="hero-label">Bruttó összeg</div>
            <div class="hero-value">${Utils.formatHuf(t.gross)}</div>
            <div class="hero-meta"><span>${Utils.formatDate(p.createdAt)}</span></div>
          </div>
        </div>

        <div class="card fade-in">
          <div class="card-title">${Icons.list}Tételek</div>
          <div class="line-list">${itemsHtml}</div>
          <div class="totals">
            <div class="totals-row"><span>Nettó</span><span>${Utils.formatHuf(t.net)}</span></div>
            <div class="totals-row"><span>Áfa (${p.vatRate}%)</span><span>${Utils.formatHuf(t.vat)}</span></div>
            <div class="totals-row grand"><span>Bruttó</span><span>${Utils.formatHuf(t.gross)}</span></div>
          </div>
          ${p.note ? `<div style="margin-top:14px;font-size:.85rem;color:var(--muted);"><b style="color:var(--text);">Megjegyzés:</b> ${Utils.escapeHtml(p.note)}</div>` : ''}
        </div>

        <div class="card fade-in">
          <div class="card-title">${Icons.check}Döntés</div>
          <p class="card-sub">Koppints, és a választásod WhatsApp-on elküldjük az ajánlattevőnek.</p>
          <a href="${wa(acceptMsg)}" target="_blank" rel="noopener" class="btn btn-success" style="margin-bottom:10px;text-decoration:none;">${Icons.check}Elfogadom</a>
          <a href="${wa(declineMsg)}" target="_blank" rel="noopener" class="btn btn-ghost" style="text-decoration:none;">${Icons.x}Nem fogadom el</a>
        </div>
      </div>
    `;
  },

  /* ===== CATALOG ===== */
  renderCatalog() {
    const catalog = Store.catalog;
    const itemsHtml = catalog.map(c => `
      <div class="quote-item" style="cursor:default;">
        <div class="avatar" style="background:var(--primary-soft);color:var(--primary);">${Utils.escapeHtml(Utils.initials(c.name))}</div>
        <div class="quote-body">
          <div class="quote-name">${Utils.escapeHtml(c.name)}</div>
          <div class="quote-sub">${Utils.formatHuf(c.price)} / ${Utils.escapeHtml(c.unit)}</div>
        </div>
        <button class="btn btn-ghost btn-sm" onclick="Views.editCatalogItem('${c.id}')" style="margin-right:6px;">${Icons.edit}</button>
        <button class="btn btn-ghost btn-sm" onclick="Views.deleteCatalogItem('${c.id}')" style="color:var(--danger);">${Icons.trash}</button>
      </div>
    `).join('');

    document.getElementById('app').innerHTML = `
      ${Layout.header('Katalógus', 'Saját tételek — koppintással árajánlatba')}
      <div class="container">
        <button class="btn btn-primary" onclick="Views.addCatalogItem()" style="margin-bottom:16px;">${Icons.plus}Új tétel</button>
        ${catalog.length === 0 ? `<div class="empty"><div class="empty-icon">${Icons.folder}</div><h3>Üres a katalógus</h3><p>Adj hozzá tételeket, hogy egy koppintással árajánlatba kerüljenek.</p></div>` : `<div class="quote-list fade-in">${itemsHtml}</div>`}
      </div>
      ${Layout.nav('catalog')}
    `;
  },

  addCatalogItem() {
    const name = prompt('Tétel neve:'); if (!name) return;
    const unit = prompt('Egység (db, m², méter, óra...):', 'db') || 'db';
    const price = parseFloat(prompt('Egységár (Ft):', '10000')) || 0;
    Store.data.catalog.push({ id: 'c' + Date.now(), name, unit, price });
    Store.save(); Toast.show('Tétel hozzáadva'); this.renderCatalog();
  },

  editCatalogItem(id) {
    const c = Store.catalog.find(x => x.id === id); if (!c) return;
    const name = prompt('Tétel neve:', c.name); if (!name) return;
    const unit = prompt('Egység:', c.unit) || c.unit;
    const price = parseFloat(prompt('Egységár (Ft):', String(c.price))) || c.price;
    c.name = name; c.unit = unit; c.price = price;
    Store.save(); Toast.show('Tétel frissítve'); this.renderCatalog();
  },

  deleteCatalogItem(id) {
    if (!confirm('Törlöd ezt a tételt a katalógusból?')) return;
    Store.data.catalog = Store.catalog.filter(c => c.id !== id);
    Store.save(); Toast.show('Tétel törölve'); this.renderCatalog();
  },

  /* ===== SETTINGS ===== */
  renderSettings() {
    const c = Store.company, s = Store.settings;
    document.getElementById('app').innerHTML = `
      ${Layout.header('Beállítások', 'Cégadatok, logó, alapértelmezések')}
      <div class="container">
        <div class="card fade-in">
          <div class="card-title">${Icons.doc}Cégadatok</div>
          <p class="card-sub">Ezek jelennek meg a PDF árajánlaton.</p>
          <label>Cégnév</label>
          <input type="text" value="${Utils.escapeHtml(c.name)}" placeholder="Példa Kft." oninput="Views.setCompany('name',this.value)">
          <label>Cím</label>
          <input type="text" value="${Utils.escapeHtml(c.address)}" placeholder="1052 Budapest, Deák tér 1." oninput="Views.setCompany('address',this.value)">
          <div class="row-2" style="margin-top:14px;">
            <div><label>Adószám</label><input type="text" value="${Utils.escapeHtml(c.taxNumber)}" placeholder="12345678-1-41" oninput="Views.setCompany('taxNumber',this.value)"></div>
            <div><label>Telefon</label><input type="tel" value="${Utils.escapeHtml(c.phone)}" placeholder="+36 30 123 4567" oninput="Views.setCompany('phone',this.value)"></div>
          </div>
          <label>Email</label>
          <input type="email" value="${Utils.escapeHtml(c.email)}" placeholder="info@example.com" oninput="Views.setCompany('email',this.value)">
        </div>

        <div class="card fade-in">
          <div class="card-title">${Icons.image}Logó</div>
          <p class="card-sub">Ez jelenik meg a PDF fejlécében.</p>
          <div class="logo-row">
            <div class="logo-box">${c.logo ? `<img src="${c.logo}" alt="logo">` : Icons.image}</div>
            <div class="logo-actions">
              <input type="file" id="s-logo" accept="image/*" onchange="Views.uploadLogo(this)" style="display:none;">
              <button class="btn btn-ghost btn-sm" onclick="document.getElementById('s-logo').click()" style="width:100%;">${Icons.share}Feltöltés</button>
              ${c.logo ? `<button class="btn btn-ghost btn-sm" onclick="Views.removeLogo()" style="width:100%;color:var(--danger);">${Icons.trash}Törlés</button>` : ''}
            </div>
          </div>
        </div>

        <div class="card fade-in">
          <div class="card-title">${Icons.gear}Alapértelmezések</div>
          <label>Alap áfa kulcs</label>
          <select onchange="Views.setSetting('defaultVat', parseFloat(this.value))">
            <option value="27" ${s.defaultVat===27?'selected':''}>27%</option>
            <option value="18" ${s.defaultVat===18?'selected':''}>18%</option>
            <option value="5"  ${s.defaultVat===5?'selected':''}>5%</option>
            <option value="0"  ${s.defaultVat===0?'selected':''}>0%</option>
          </select>
          <div class="row-2" style="margin-top:14px;">
            <div><label>Előtag</label><input type="text" value="${Utils.escapeHtml(s.quotePrefix)}" placeholder="AJ" oninput="Views.setSetting('quotePrefix',this.value.toUpperCase())"></div>
            <div><label>Következő szám</label><input type="number" value="${s.nextNumber}" min="1" oninput="Views.setSetting('nextNumber',parseInt(this.value)||1)"></div>
          </div>
        </div>

        <div class="card fade-in">
          <div class="card-title">${Icons.alert}Adatok</div>
          <p class="card-sub">Minden adat a telefonodon marad (localStorage). Nincs szerver, nincs felhő.</p>
          <button class="btn btn-ghost" onclick="Views.exportData()" style="margin-bottom:10px;">${Icons.download}Adatok exportálása</button>
          <button class="btn btn-ghost" onclick="Views.resetData()" style="color:var(--danger);">${Icons.trash}Összes adat törlése</button>
        </div>

        <div class="footer-note">Árajánlat v2.0 · Adatgyűjtés nélkül · Ingyenes</div>
      </div>
      ${Layout.nav('settings')}
    `;
  },

  setCompany(f, v) { Store.data.company[f] = v; Store.save(); },
  setSetting(f, v) { Store.data.settings[f] = v; Store.save(); },

  uploadLogo(input) {
    const file = input.files[0]; if (!file) return;
    if (file.size > 500 * 1024) { Toast.show('A logó maximum 500 KB lehet'); return; }
    const r = new FileReader();
    r.onload = e => {
      Store.data.company.logo = e.target.result; Store.save();
      Toast.show('Logó feltöltve'); this.renderSettings();
    };
    r.readAsDataURL(file);
  },

  removeLogo() { Store.data.company.logo = ''; Store.save(); Toast.show('Logó törölve'); this.renderSettings(); },

  exportData() {
    const blob = new Blob([JSON.stringify(Store.data, null, 2)], { type: 'application/json' });
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url;
    a.download = 'arajnlat_backup_' + new Date().toISOString().slice(0,10) + '.json';
    a.click();
    URL.revokeObjectURL(url);
    Toast.show('Adatok exportálva');
  },

  resetData() {
    if (!confirm('Biztosan törlöd az ÖSSZES adatot? Nem visszavonható.')) return;
    localStorage.removeItem(STORAGE_KEY);
    Store.load(); Toast.show('Adatok törölve'); Router.navigate('#/');
  }
};

/* ---------- INIT ---------- */
Store.load();
Router.start();
</script>
</body>
</html>
