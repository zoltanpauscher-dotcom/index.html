  handlePhotoUpload(input) {
    const file = input.files[0];
    if (!file) return;
    // Compress image significantly for localStorage
    const reader = new FileReader();
    reader.onload = (e) => {
      const img = new Image();
      img.onload = () => {
        const canvas = document.createElement('canvas');
        const MAX = 400;
        let w = img.width, h = img.height;
        if (w > h) { if (w > MAX) { h = Math.round(h * MAX / w); w = MAX; } }
        else { if (h > MAX) { w = Math.round(w * MAX / h); h = MAX; } }
        canvas.width = w; canvas.height = h;
        const ctx = canvas.getContext('2d');
        ctx.drawImage(img, 0, 0, w, h);
        window.__tempItemImage = canvas.toDataURL('image/jpeg', 0.6);
        
        const box = document.querySelector('.photo-upload-box');
        box.innerHTML = `<img src="${window.__tempItemImage}" class="photo-preview">`;
      };
      img.src = e.target.result;
    };
    reader.readAsDataURL(file);
  },

  startDictation() {
    if (!recognition) {
      Toast.show('A hangbevitel nem támogatott ezen a böngészőn.');
      return;
    }
    const btn = document.getElementById('mic-btn');
    const input = document.getElementById('mi-name');
    
    if (btn.classList.contains('listening')) {
      recognition.stop();
      return;
    }

    btn.classList.add('listening');
    Utils.vibrate();
    
    recognition.onresult = (e) => {
      const text = e.results[0][0].transcript;
      input.value = text;
      btn.classList.remove('listening');
      Utils.vibrate();
    };
    
    recognition.onerror = () => {
      btn.classList.remove('listening');
      Toast.show('Hiba a hangfelismerésnél.');
    };
    
    recognition.onend = () => {
      btn.classList.remove('listening');
    };

    recognition.start();
    Toast.show('Hallgatom... Mondd be a tételt!');
  },

  aiPriceTip() {
    Utils.vibrate();
    const name = document.getElementById('mi-name').value.toLowerCase();
    const priceInput = document.getElementById('mi-price');
    
    if (!name) {
      Toast.show('Előbb írd be a tétel nevét!');
      return;
    }

    // 1. Keresés a katalógusban
    let matches = Store.catalog.filter(c => c.name.toLowerCase().includes(name) || name.includes(c.name.toLowerCase()));
    let tip = 0;

    if (matches.length > 0) {
      tip = matches.reduce((s, c) => s + c.price, 0) / matches.length;
    } else {
      // 2. Keresés a korábbi árajánlatokban
      const pastItems = Store.quotes.flatMap(q => q.items).filter(it => it.name.toLowerCase().includes(name));
      if (pastItems.length > 0) {
        tip = pastItems.reduce((s, it) => s + it.unitPrice, 0) / pastItems.length;
      } else {
        // 3. Default tipp
        tip = 10000; 
      }
    }

    priceInput.value = Math.round(tip / 100) * 100;
    priceInput.style.backgroundColor = 'var(--warning-soft)';
    setTimeout(() => priceInput.style.backgroundColor = '', 500);
    Toast.show('Ár tipp beállítva!');
  },

