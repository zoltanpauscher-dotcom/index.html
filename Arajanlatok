  /* MISC */
  .toast{position:fixed;left:50%;bottom:calc(100px + env(safe-area-inset-bottom));transform:translateX(-50%);z-index:300;background:#14131a;color:#fff;padding:12px 18px;border-radius:12px;font-size:.86rem;font-weight:500;box-shadow:0 12px 32px rgba(20,19,26,.3);max-width:calc(100vw - 32px);text-align:center;animation:toastIn .22s cubic-bezier(.2,.8,.3,1.1)}
  @keyframes toastIn{from{opacity:0;transform:translate(-50%,12px)}to{opacity:1;transform:translate(-50%,0)}}
