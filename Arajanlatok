<!DOCTYPE html>
<html lang="hu">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover">
<meta name="theme-color" content="#4f46e5">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
<title>Árajánlat — 60 másodperc alatt</title>
<style>
  *{margin:0;padding:0;box-sizing:border-box;-webkit-tap-highlight-color:transparent}
  :root{
    --bg:#f4f2ee; --surface:#ffffff; --surface-2:#faf9f6;
    --text:#14131a; --muted:#6b6773; --muted-2:#9a95a3;
    --border:#e8e4dc; --border-2:#d6d0c4;
    --primary:#4f46e5; --primary-2:#4338ca; --primary-soft:#eef0ff; --primary-ink:#312e81;
    --accent:#f59e0b;
    --success:#059669; --success-soft:#ecfdf5;
    --danger:#dc2626; --danger-soft:#fef2f2;
    --warning:#d97706; --warning-soft:#fffbeb;
    --shadow-sm:0 1px 2px rgba(20,19,26,.04);
    --shadow-md:0 1px 2px rgba(20,19,26,.04),0 8px 24px rgba(20,19,26,.06);
    --shadow-lg:0 12px 32px rgba(79,70,229,.32);
    --r:16px; --r-sm:10px; --r-xs:8px;
  }
  @media (prefers-color-scheme: dark) {
    :root {
      --bg:#0f0e13; --surface:#1a1823; --surface-2:#24212f;
      --text:#f4f2ee; --muted:#9a95a3; --muted-2:#6b6773;
      --border:#2d2938; --border-2:#3f3b4d;
      --primary:#6366f1; --primary-2:#4f46e5; --primary-soft:#1e1b4b; --primary-ink:#c7d2fe;
      --success:#10b981; --success-soft:#064e3b;
      --danger:#ef4444; --danger-soft:#450a0a;
      --warning:#f59e0b; --warning-soft:#451a03;
      --shadow-sm:0 1px 2px rgba(0,0,0,.4);
      --shadow-md:0 4px 12px rgba(0,0,0,.5);
      --shadow-lg:0 12px 32px rgba(0,0,0,.6);
    }
    .app-header { background: linear-gradient(135deg,#4338ca 0%,#312e81 100%); }
    .hero { background: linear-gradient(135deg,#4338ca,#312e81); }
    .bottom-nav { background: rgba(26,24,35,.88); border-top-color: rgba(255,255,255,.05); }
    .action-bar { background: rgba(26,24,35,.92); border-top-color: rgba(255,255,255,.05); }
    .qty { background: var(--surface-2); }
    input, select, textarea { background: var(--surface-2); color: var(--text); }
  }
  html{-webkit-text-size-adjust:100%}
  body{
    font-family:-apple-system,BlinkMacSystemFont,"SF Pro Text","Segoe UI",Roboto,Inter,sans-serif;
    background:var(--bg); color:var(--text); line-height:1.5; min-height:100vh; font-size:16px;
    -webkit-font-smoothing:antialiased; -moz-osx-font-smoothing:grayscale;
    font-feature-settings:"ss01","cv11";
  }
  ::selection{background:var(--primary-soft);color:var(--primary-ink)}
  .app-shell{padding-bottom:calc(84px + env(safe-area-inset-bottom))}
  .app-shell.no-nav{padding-bottom:calc(96px + env(safe-area-inset-bottom))}

  /* HEADER */
  .app-header{
    position:sticky;top:0;z-index:100;
    background:linear-gradient(135deg,#4f46e5 0%,#4338ca 55%,#3730a3 100%);
    color:#fff; padding:calc(14px + env(safe-area-inset-top)) 18px 16px;
    box-shadow:0 1px 0 rgba(255,255,255,.06) inset,0 6px 20px rgba(55,48,163,.18);
  }
  .brand{display:flex;align-items:center;gap:12px;position:relative;z-index:1}
  .brand-mark{
    width:40px;height:40px;border-radius:12px;flex:0 0 40px;
    background:rgba(255,255,255,.14); border:1px solid rgba(255,255,255,.22);
    display:flex;align-items:center;justify-content:center;
    backdrop-filter:blur(6px);-webkit-backdrop-filter:blur(6px);
  }
  .brand-mark svg{width:22px;height:22px;stroke:#fff;fill:none;stroke-width:2;stroke-linecap:round;stroke-linejoin:round}
  .brand-text h1{font-size:1.05rem;font-weight:650;letter-spacing:-.02em;line-height:1.2}
  .brand-text p{font-size:.78rem;color:rgba(255,255,255,.72);margin-top:2px;letter-spacing:-.005em}
  .header-back{
    position:absolute;left:14px;top:50%;transform:translateY(-50%);
    width:36px;height:36px;border-radius:10px;border:none;
    background:rgba(255,255,255,.12);color:#fff;font-size:1.1rem;
    display:flex;align-items:center;justify-content:center;cursor:pointer;
  }
  .header-back:active{background:rgba(255,255,255,.22)}

  /* CONTAINER */
  .container{max-width:640px;margin:0 auto;padding:16px 16px 24px}
  .section-label{
    font-size:.72rem;font-weight:650;letter-spacing:.08em;text-transform:uppercase;
    color:var(--muted-2);margin:22px 4px 10px;
  }

  /* HERO CARD */
  .hero{
    position:relative;overflow:hidden;
    background:linear-gradient(135deg,#4f46e5,#4338ca 60%,#3730a3);
    color:#fff;border-radius:20px;padding:20px;
    box-shadow:0 10px 30px rgba(67,56,202,.22);
    margin-bottom:6px;
  }
  .hero::before{
    content:"";position:absolute;right:-30px;top:-30px;width:140px;height:140px;border-radius:50%;
    background:radial-gradient(circle,rgba(255,255,255,.18),transparent 70%);
  }
  .hero::after{
    content:"";position:absolute;left:-20px;bottom:-40px;width:120px;height:120px;border-radius:50%;
    background:radial-gradient(circle,rgba(245,158,11,.22),transparent 70%);
  }
  .hero-inner{position:relative;z-index:1}
  .hero-label{font-size:.78rem;color:rgba(255,255,255,.75);letter-spacing:.02em}
  .hero-value{font-size:2rem;font-weight:750;letter-spacing:-.03em;margin:4px 0 6px;font-variant-numeric:tabular-nums}
  .hero-meta{display:flex;gap:14px;font-size:.8rem;color:rgba(255,255,255,.8)}
  .hero-meta b{color:#fff;font-weight:650}

  /* CARDS */
  .card{
    background:var(--surface);border-radius:var(--r);padding:18px;
    margin-bottom:14px;box-shadow:var(--shadow-sm);
    border:1px solid var(--border);
    animation: slideUp 0.3s ease-out forwards;
  }
  .card-title{
    font-size:.95rem;font-weight:650;letter-spacing:-.01em;
    margin-bottom:14px;display:flex;align-items:center;gap:8px;
  }
  .card-title svg{width:16px;height:16px;stroke:var(--muted);fill:none;stroke-width:2;stroke-linecap:round;stroke-linejoin:round}
  .card-sub{font-size:.82rem;color:var(--muted);margin-bottom:14px;line-height:1.5}

  /* FORM & INPUTS */
  label{display:block;font-size:.8rem;font-weight:550;color:var(--muted);margin:14px 0 6px}
  label:first-of-type{margin-top:0}
  label .req{color:var(--danger);margin-left:2px}
  input,select,textarea{
    width:100%;padding:13px 14px;
    border:1.5px solid var(--border);border-radius:12px;
    font-size:16px;font-family:inherit;font-weight:450;
    background:var(--surface);color:var(--text);
    -webkit-appearance:none;appearance:none;
    transition:border-color .15s,box-shadow .15s,background .15s;
  }
  input::placeholder,textarea::placeholder{color:var(--muted-2)}
  input:focus,select:focus,textarea:focus{
    outline:none;border-color:var(--primary);
    box-shadow:0 0 0 4px rgba(79,70,229,.12);
    background:var(--surface);
  }
  .row-2{display:grid;grid-template-columns:1fr 1fr;gap:10px}
  .row-2 label{margin-top:0}

  /* LIVE TOTAL BAR */
  .live-total-bar {
    position: sticky; top: calc(58px + env(safe-area-inset-top)); z-index: 50;
    background: var(--primary-soft); color: var(--primary-ink);
    padding: 12px 18px; border-radius: 14px; margin-bottom: 16px;
    display: flex; justify-content: space-between; align-items: center;
    box-shadow: 0 4px 12px rgba(79,70,229,.15);
    font-weight: 600; font-size: 0.95rem;
    transition: transform 0.1s ease, background 0.3s;
  }
  .live-total-bar .total-amount { font-size: 1.2rem; font-weight: 750; letter-spacing: -.02em; }
  .live-total-bar.flash { background: var(--primary); color: white; transform: scale(1.02); }

  /* BUTTONS */
  .btn{
    display:inline-flex;align-items:center;justify-content:center;gap:8px;
    width:100%;padding:0 20px;min-height:50px;
    border:none;border-radius:12px;
    font-size:16px;font-weight:600;font-family:inherit;letter-spacing:-.01em;
    cursor:pointer;transition:transform .1s,opacity .15s,box-shadow .15s,background .15s;
    text-decoration:none;color:#fff;white-space:nowrap;
  }
  .btn:active{transform:scale(.96)}
  .btn svg{width:18px;height:18px;stroke:currentColor;fill:none;stroke-width:2;stroke-linecap:round;stroke-linejoin:round}
  .btn-primary{background:linear-gradient(180deg,#5b52ea,#4f46e5);box-shadow:0 1px 0 rgba(255,255,255,.18) inset,0 4px 14px rgba(79,70,229,.28)}
  .btn-primary:active{background:linear-gradient(180deg,#4f46e5,#4338ca)}
  .btn-success{background:linear-gradient(180deg,#10b981,#059669);box-shadow:0 4px 14px rgba(5,150,105,.22)}
  .btn-danger{background:linear-gradient(180deg,#ef4444,#dc2626);box-shadow:0 4px 14px rgba(220,38,38,.2)}
  .btn-ghost{background:var(--surface);color:var(--text);border:1.5px solid var(--border)}
  .btn-ghost:active{background:var(--surface-2)}
  .btn-soft{background:var(--primary-soft);color:var(--primary-ink);border:none}
  .btn-sm{min-height:38px;padding:0 14px;font-size:.85rem;width:auto;border-radius:10px;font-weight:600}
  .btn-row{display:flex;gap:10px;margin-top:14px}
  .btn-row .btn{flex:1}

  /* QUOTE LIST */
  .quote-list{display:flex;flex-direction:column;gap:10px}
  .quote-item{
    display:flex;align-items:center;gap:12px;
    padding:14px;background:var(--surface);
    border-radius:14px;box-shadow:var(--shadow-sm);
    border:1px solid var(--border);
    cursor:pointer;transition:transform .1s,box-shadow .15s;
  }
  .quote-item:active{transform:scale(.98);box-shadow:var(--shadow-md)}
  .avatar{
    width:44px;height:44px;border-radius:12px;flex:0 0 44px;
    display:flex;align-items:center;justify-content:center;
    font-weight:700;font-size:.95rem;letter-spacing:-.02em;
    background:var(--warning-soft);color:var(--warning);
  }
  .quote-item.is-accepted .avatar{background:var(--success-soft);color:var(--success)}
  .quote-item.is-declined .avatar{background:var(--danger-soft);color:var(--danger)}
  .quote-body{flex:1;min-width:0}
  .quote-name{font-weight:600;font-size:.95rem;letter-spacing:-.01em;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;margin-bottom:3px}
  .quote-sub{font-size:.78rem;color:var(--muted);display:flex;align-items:center;gap:6px;flex-wrap:wrap}
  .quote-amount{font-weight:700;font-size:.98rem;letter-spacing:-.01em;color:var(--text);font-variant-numeric:tabular-nums;white-space:nowrap}

  /* REMINDER BANNER */
  .reminder-banner {
    background: var(--warning-soft); color: var(--warning);
    padding: 12px 16px; border-radius: 12px; margin-bottom: 16px;
    display: flex; align-items: flex-start; gap: 10px;
    font-size: 0.85rem; line-height: 1.4; border: 1px solid rgba(245,158,11,.3);
  }
  .reminder-banner svg { width: 20px; height: 20px; flex-shrink: 0; stroke: currentColor; fill: none; stroke-width: 2; }

  /* STATUS PILL */
  .pill{
    display:inline-flex;align-items:center;gap:5px;
    padding:3px 9px;border-radius:999px;
    font-size:.68rem;font-weight:650;letter-spacing:.02em;text-transform:uppercase;
  }
  .pill::before{content:"";width:5px;height:5px;border-radius:50%;background:currentColor}
  .pill-pending{background:var(--warning-soft);color:var(--warning)}
  .pill-accepted{background:var(--success-soft);color:var(--success)}
  .pill-declined{background:var(--danger-soft);color:var(--danger)}

  /* LINE ITEMS */
  .line-list{display:flex;flex-direction:column;gap:8px}
  .line{
    display:flex;align-items:center;gap:10px;
    padding:12px;background:var(--surface-2);
    border-radius:12px;border:1px solid var(--border);
  }
  .line-img { width: 40px; height: 40px; border-radius: 8px; object-fit: cover; border: 1px solid var(--border); flex-shrink: 0; }
  .line-body{flex:1;min-width:0}
  .line-name{font-weight:550;font-size:.9rem;letter-spacing:-.005em;margin-bottom:2px}
  .line-meta{font-size:.76rem;color:var(--muted);font-variant-numeric:tabular-nums}
  .line-price{font-weight:650;font-size:.88rem;font-variant-numeric:tabular-nums;white-space:nowrap;margin-right:4px}
  .qty{display:flex;align-items:center;gap:0;background:var(--surface);border:1px solid var(--border);border-radius:9px;overflow:hidden}
  .qty button{width:30px;height:30px;border:none;background:none;font-size:1rem;font-weight:600;color:var(--muted);cursor:pointer;display:flex;align-items:center;justify-content:center}
  .qty button:active{background:var(--primary-soft);color:var(--primary)}
  .qty span{min-width:24px;text-align:center;font-size:.82rem;font-weight:600;font-variant-numeric:tabular-nums}
  .line-remove{width:28px;height:28px;border-radius:8px;border:none;background:none;color:var(--muted-2);font-size:1.1rem;cursor:pointer;display:flex;align-items:center;justify-content:center;flex:0 0 28px}
  .line-remove:active{background:var(--danger-soft);color:var(--danger)}

  /* TOTALS */
  .totals{
    margin-top:16px;padding:16px;border-radius:14px;
    background:linear-gradient(180deg,var(--surface-2),var(--surface));
    border:1px solid var(--border);
  }
  .totals-row{display:flex;justify-content:space-between;padding:5px 0;font-size:.88rem;color:var(--muted);font-variant-numeric:tabular-nums}
  .totals-row span:last-child{color:var(--text);font-weight:550}
  .totals-row.grand{margin-top:10px;padding-top:12px;border-top:1.5px solid var(--border-2);font-size:1.05rem;color:var(--text);font-weight:700}
  .totals-row.grand span:last-child{color:var(--primary);font-size:1.15rem;font-weight:750;letter-spacing:-.02em}

  /* NAV */
  .bottom-nav{
    position:fixed;bottom:0;left:0;right:0;z-index:100;
    background:rgba(255,255,255,.88);
    backdrop-filter:blur(20px) saturate(180%);-webkit-backdrop-filter:blur(20px) saturate(180%);
    border-top:1px solid var(--border);
    display:flex;padding:6px 8px calc(6px + env(safe-area-inset-bottom));
  }
  .nav-item{
    flex:1;display:flex;flex-direction:column;align-items:center;gap:3px;
    padding:7px 4px;border:none;background:none;
    color:var(--muted-2);font-size:.68rem;font-weight:600;
    font-family:inherit;letter-spacing:.01em;cursor:pointer;text-decoration:none;
    border-radius:10px;transition:color .15s,background .15s;
  }
  .nav-item svg{width:22px;height:22px;stroke:currentColor;fill:none;stroke-width:1.9;stroke-linecap:round;stroke-linejoin:round}
  .nav-item.active{color:var(--primary);background:var(--primary-soft)}
  .nav-item.active svg{stroke-width:2.2}

  /* FAB */
  .fab{
    position:fixed;right:18px;bottom:calc(88px + env(safe-area-inset-bottom));
    width:58px;height:58px;border-radius:18px;border:none;
    background:linear-gradient(180deg,#5b52ea,#4f46e5);color:#fff;
    box-shadow:var(--shadow-lg);cursor:pointer;z-index:90;
    display:flex;align-items:center;justify-content:center;
    transition:transform .1s;
  }
  .fab:active{transform:scale(.9)}
  .fab svg{width:26px;height:26px;stroke:#fff;fill:none;stroke-width:2.4;stroke-linecap:round;stroke-linejoin:round}

  /* STICKY ACTION BAR */
  .action-bar{
    position:fixed;bottom:0;left:0;right:0;z-index:100;
    background:rgba(255,255,255,.92);
    backdrop-filter:blur(20px) saturate(180%);-webkit-backdrop-filter:blur(20px) saturate(180%);
    border-top:1px solid var(--border);
    padding:12px 16px calc(12px + env(safe-area-inset-bottom));
    display:flex;gap:10px;max-width:640px;margin:0 auto;
  }
  .action-bar .btn{flex:1}
  .action-bar .btn-ghost{flex:0 0 40%}

  /* MODAL */
  .modal-overlay {
    position: fixed; inset: 0; background: rgba(0,0,0,0.6);
    backdrop-filter: blur(4px); -webkit-backdrop-filter: blur(4px);
    display: flex; align-items: flex-end; justify-content: center;
    z-index: 500; animation: fadeIn 0.2s ease-out;
  }
  .modal-content {
    background: var(--surface); width: 100%; max-width: 640px;
    border-radius: 24px 24px 0 0; padding: 24px;
    max-height: 90vh; overflow-y: auto;
    animation: slideUpModal 0.3s cubic-bezier(0.16, 1, 0.3, 1);
    box-shadow: 0 -10px 40px rgba(0,0,0,0.2);
  }
  @keyframes slideUpModal { from { transform: translateY(100%); } to { transform: translateY(0); } }
  .modal-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px; }
  .modal-header h2 { font-size: 1.2rem; font-weight: 700; }
  .close-btn { background: var(--surface-2); border: none; width: 32px; height: 32px; border-radius: 50%; display: flex; align-items: center; justify-content: center; cursor: pointer; color: var(--muted); }

  /* MICROPHONE & PHOTO */
  .input-with-mic { position: relative; }
  .input-with-mic input { padding-right: 44px; }
  .mic-btn {
    position: absolute; right: 8px; top: 50%; transform: translateY(-50%);
    background: var(--primary-soft); border: none; width: 32px; height: 32px;
    border-radius: 8px; display: flex; align-items: center; justify-content: center;
    color: var(--primary); cursor: pointer; transition: background 0.2s;
  }
  .mic-btn.listening { background: var(--danger); color: white; animation: pulse 1s infinite; }
  @keyframes pulse { 0% { box-shadow: 0 0 0 0 rgba(220,38,38,0.4); } 70% { box-shadow: 0 0 0 10px rgba(220,38,38,0); } 100% { box-shadow: 0 0 0 0 rgba(220,38,38,0); } }
  .photo-upload-box {
    border: 2px dashed var(--border-2); border-radius: 12px; padding: 16px;
    text-align: center; cursor: pointer; background: var(--surface-2);
    color: var(--muted); font-size: 0.85rem; transition: border-color 0.2s;
  }
  .photo-upload-box:active { border-color: var(--primary); }
  .photo-preview { width: 100%; max-height: 120px; object-fit: contain; border-radius: 8px; margin-top: 10px; }

  /* RECENT CLIENTS */
  .recent-clients { display: flex; gap: 8px; overflow-x: auto; padding-bottom: 4px; margin-top: 8px; scrollbar-width: none; }
  .recent-clients::-webkit-scrollbar { display: none; }
  .recent-client-btn {
    background: var(--surface-2); border: 1px solid var(--border);
    padding: 6px 12px; border-radius: 20px; font-size: 0.8rem; font-weight: 550;
    white-space: nowrap; color: var(--text); cursor: pointer;
  }
  .recent-client-btn:active { background: var(--primary-soft); border-color: var(--primary); color: var(--primary); }

  /* PDF */
  .pdf-doc{
    width:794px;background:#fff;color:#14131a;
    font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,Arial,sans-serif;
    padding:0;position:relative;
  }
  .pdf-accent{height:8px;background:linear-gradient(90deg,#4f46e5,#4338ca 60%,#f59e0b)}
  .pdf-inner{padding:48px 52px 60px}
  .pdf-head{display:flex;justify-content:space-between;align-items:flex-start;margin-bottom:36px;padding-bottom:24px;border-bottom:1px solid #e8e4dc}
  .pdf-logo{max-height:64px;max-width:200px;object-fit:contain}
  .pdf-company{font-size:19px;font-weight:750;color:#14131a;letter-spacing:-.02em}
  .pdf-company-meta{font-size:11.5px;color:#6b6773;margin-top:6px;line-height:1.5}
  .pdf-doc-title{text-align:right}
  .pdf-doc-title h1{font-size:26px;font-weight:750;color:#4f46e5;letter-spacing:-.03em;line-height:1}
  .pdf-doc-title .num{font-size:12px;color:#6b6773;margin-top:6px;font-weight:600;letter-spacing:.04em}
  .pdf-doc-title .date{font-size:11.5px;color:#9a95a3;margin-top:3px}
  .pdf-parties{display:grid;grid-template-columns:1fr 1fr;gap:28px;margin-bottom:32px}
  .pdf-party-label{font-size:10px;font-weight:700;color:#9a95a3;text-transform:uppercase;letter-spacing:.1em;margin-bottom:8px}
  .pdf-party-body{font-size:12.5px;line-height:1.65;color:#14131a}
  .pdf-party-body b{font-weight:650}
  .pdf-party-body .muted{color:#6b6773}
  .pdf-table{width:100%;border-collapse:collapse;margin-bottom:20px;font-size:12.5px}
  .pdf-table thead th{background:#f4f2ee;color:#6b6773;font-size:10px;font-weight:700;text-transform:uppercase;letter-spacing:.08em;padding:11px 12px;text-align:left;border-bottom:1px solid #e8e4dc}
  .pdf-table thead th.r{text-align:right}
  .pdf-table tbody td{padding:12px;border-bottom:1px solid #f0ece4;vertical-align:middle}
  .pdf-table tbody td.r{text-align:right;font-variant-numeric:tabular-nums}
  .pdf-table tbody td.item{font-weight:550}
  .pdf-table tbody td.item small{display:block;color:#9a95a3;font-weight:400;font-size:10.5px;margin-top:2px}
  .pdf-totals{display:flex;justify-content:flex-end;margin-bottom:32px}
  .pdf-totals-box{width:280px;background:#faf9f6;border:1px solid #e8e4dc;border-radius:12px;padding:16px 18px}
  .pdf-totals-row{display:flex;justify-content:space-between;padding:5px 0;font-size:12.5px;color:#6b6773}
