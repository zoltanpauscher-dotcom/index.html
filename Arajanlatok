  @media(min-width:520px){
    .cat-grid{grid-template-columns:1fr 1fr}
    .hero-value{font-size:2.3rem}
  }
</style>
</head>
<body>
<div id="app" class="app-shell"></div>

<script src="https://cdnjs.cloudflare.com/ajax/libs/html2pdf.js/0.10.1/html2pdf.bundle.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/qrious@4.0.2/dist/qrious.min.js"></script>
<script>
/* ============================================================
   Árajánlat v2.0 — prémium szaki árajánlat
   ============================================================ */

const STORAGE_KEY = 'arajnlat_app_v2';

/* ---------- ICONS ---------- */
const Icons = {
  doc: '<svg viewBox="0 0 24 24"><path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8z"/><path d="M14 3v5h5"/><path d="M9 13h6M9 17h4"/></svg>',
  docCheck: '<svg viewBox="0 0 24 24"><path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8z"/><path d="M14 3v5h5"/><path d="M9 15l2 2 4-4"/></svg>',
  list: '<svg viewBox="0 0 24 24"><path d="M8 6h13M8 12h13M8 18h13"/><circle cx="3.5" cy="6" r="1"/><circle cx="3.5" cy="12" r="1"/><circle cx="3.5" cy="18" r="1"/></svg>',
  folder: '<svg viewBox="0 0 24 24"><path d="M3 7a2 2 0 0 1 2-2h4l2 2h8a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/></svg>',
  gear: '<svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 1 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 1 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 1 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 1 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z"/></svg>',
  plus: '<svg viewBox="0 0 24 24"><path d="M12 5v14M5 12h14"/></svg>',
  pdf: '<svg viewBox="0 0 24 24"><path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8z"/><path d="M14 3v5h5"/><path d="M9 13h1.5a1.5 1.5 0 0 1 0 3H9v-3zM9 16v2"/><path d="M14 13v5"/><path d="M14 13h2"/></svg>',
  share: '<svg viewBox="0 0 24 24"><path d="M4 12v8a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-8"/><path d="M16 6l-4-4-4 4"/><path d="M12 2v13"/></svg>',
  edit: '<svg viewBox="0 0 24 24"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.12 2.12 0 0 1 3 3L12 15l-4 1 1-4z"/></svg>',
  trash: '<svg viewBox="0 0 24 24"><path d="M3 6h18M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/><path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6"/><path d="M10 11v6M14 11v6"/></svg>',
  check: '<svg viewBox="0 0 24 24"><path d="M20 6L9 17l-5-5"/></svg>',
  x: '<svg viewBox="0 0 24 24"><path d="M18 6L6 18M6 6l12 12"/></svg>',
  book: '<svg viewBox="0 0 24 24"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/></svg>',
  image: '<svg viewBox="0 0 24 24"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><path d="M21 15l-5-5L5 21"/></svg>',
  download: '<svg viewBox="0 0 24 24"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><path d="M7 10l5 5 5-5"/><path d="M12 15V3"/></svg>',
  alert: '<svg viewBox="0 0 24 24"><path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/><path d="M12 9v4M12 17h.01"/></svg>',
  back: '<svg viewBox="0 0 24 24"><path d="M15 18l-6-6 6-6"/></svg>',
  phone: '<svg viewBox="0 0 24 24"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>',
  mail: '<svg viewBox="0 0 24 24"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><path d="M22 6l-10 7L2 6"/></svg>',
  pin: '<svg viewBox="0 0 24 24"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>',
  mic: '<svg viewBox="0 0 24 24"><path d="M12 2a3 3 0 0 0-3 3v7a3 3 0 0 0 6 0V5a3 3 0 0 0-3-3z"/><path d="M19 10v2a7 7 0 0 1-14 0v-2"/><line x1="12" y1="19" x2="12" y2="22"/></svg>',
  camera: '<svg viewBox="0 0 24 24"><path d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z"/><circle cx="12" cy="13" r="4"/></svg>',
  invoice: '<svg viewBox="0 0 24 24"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/><polyline points="10 9 9 9 8 9"/></svg>'
};

/* ---------- UTILS ---------- */
const Utils = {
  formatHuf(n) {
    if (isNaN(n) || n === null || n === undefined) return '0 Ft';
    return Math.round(n).toLocaleString('hu-HU').replace(/\u00A0/g, ' ') + ' Ft';
  },
  formatDate(iso) {
    if (!iso) return '';
    const d = new Date(iso);
    return d.toLocaleDateString('hu-HU', { year: 'numeric', month: 'short', day: 'numeric' });
  },
  today() { return new Date().toISOString(); },
  uid() { return 'q' + Date.now().toString(36) + Math.random().toString(36).substr(2, 6); },
  calcTotals(items, vatRate) {
    const net = items.reduce((s, it) => s + (it.qty * it.unitPrice), 0);
    const vat = net * (vatRate / 100);
    return { net, vat, gross: net + vat };
  },
  escapeHtml(s) {
    if (s === null || s === undefined) return '';
    return String(s).replace(/[&<>"']/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
  },
  initials(name) {
    if (!name) return '?';
    const parts = name.trim().split(/\s+/).slice(0, 2);
    return parts.map(p => p[0]).join('').toUpperCase();
  },
  b64encode(str) { return btoa(unescape(encodeURIComponent(str))); },
  b64decode(str) { return decodeURIComponent(escape(atob(str))); },
  vibrate() { if (navigator.vibrate) navigator.vibrate(10); },
  getRecentClients() {
    const clients = [];
    const seen = new Set();
    const quotes = [...Store.quotes].sort((a,b) => new Date(b.createdAt) - new Date(a.createdAt));
    for (const q of quotes) {
      if (q.clientName && !seen.has(q.clientName)) {
        seen.add(q.clientName);
        clients.push({ name: q.clientName, phone: q.clientPhone, email: q.clientEmail, address: q.clientAddress });
        if (clients.length >= 5) break;
      }
    }
    return clients;
  }
};

/* ---------- STORE ---------- */
const Store = {
  data: null,
  load() {
    try {
      const raw = localStorage.getItem(STORAGE_KEY);
      this.data = raw ? JSON.parse(raw) : this.defaults();
    } catch (e) { this.data = this.defaults(); }
    if (!this.data.catalog || !this.data.catalog.length) this.data.catalog = this.defaults().catalog;
    return this.data;
  },
  defaults() {
    return {
      company: { name: '', address: '', taxNumber: '', phone: '', email: '', logo: '' },
      catalog: [
        { id: 'c1',  name: 'Konnektor csere',       unit: 'db',    price: 8000 },
        { id: 'c2',  name: 'Kapcsoló csere',        unit: 'db',    price: 6000 },
        { id: 'c3',  name: 'Kábel húzás',           unit: 'méter', price: 1500 },
        { id: 'c4',  name: 'Villanyóra szekrény',   unit: 'db',    price: 25000 },
        { id: 'c5',  name: 'Szerelvény csere',      unit: 'db',    price: 12000 },
        { id: 'c6',  name: 'Csaptelep csere',       unit: 'db',    price: 15000 },
        { id: 'c7',  name: 'WC tartály javítás',    unit: 'db',    price: 10000 },
        { id: 'c8',  name: 'Lefolyó tisztítás',     unit: 'db',    price: 8000 },
        { id: 'c9',  name: 'Festés',                unit: 'm²',    price: 2500 },
        { id: 'c10', name: 'Glettelés',             unit: 'm²',    price: 1800 },
        { id: 'c11', name: 'Burkolás',              unit: 'm²',    price: 6000 },
        { id: 'c12', name: 'Klíma telepítés',       unit: 'db',    price: 80000 },
        { id: 'c13', name: 'Kazán szerviz',         unit: 'db',    price: 25000 }
      ],
      quotes: [],
      settings: { defaultVat: 27, quotePrefix: 'AJ', nextNumber: 1 }
    };
  },
  save() {
    try { localStorage.setItem(STORAGE_KEY, JSON.stringify(this.data)); }
    catch (e) { Toast.show('Mentési hiba — tele a tárhely?'); }
  },
  get company() { return this.data.company; },
  get catalog() { return this.data.catalog; },
  get quotes() { return this.data.quotes; },
  get settings() { return this.data.settings; },
  nextQuoteNumber() {
    const n = this.settings.nextNumber;
    this.settings.nextNumber = n + 1;
    this.save();
    return this.settings.quotePrefix + '-' + String(n).padStart(4, '0');
  }
};

/* ---------- TOAST ---------- */
const Toast = {
  timer: null,
  show(msg, ms = 2400) {
    let el = document.getElementById('toast');
    if (!el) { el = document.createElement('div'); el.id = 'toast'; el.className = 'toast'; document.body.appendChild(el); }
    el.textContent = msg;
    el.style.display = 'block';
    el.style.animation = 'none';
    void el.offsetWidth;
    el.style.animation = '';
    clearTimeout(this.timer);
    this.timer = setTimeout(() => { el.style.display = 'none'; }, ms);
  }
};

/* ---------- ROUTER ---------- */
const Router = {
  navigate(hash) {
    if (window.location.hash !== hash) window.location.hash = hash;
    else this.render();
  },
  render() {
    const hash = window.location.hash || '#/';
    document.getElementById('app').classList.remove('no-nav');

    if (hash.startsWith('#accept=')) {
      try { Views.renderAccept(JSON.parse(Utils.b64decode(hash.slice(8)))); }
      catch (e) { document.getElementById('app').innerHTML = '<div class="container"><div class="card"><p>Hibás árajánlat link.</p></div></div>'; }
      return;
    }

    const parts = hash.slice(2).split('/');
    const route = parts[0] || 'dashboard';
    const param = parts[1];

    switch (route) {
      case 'new':    document.getElementById('app').classList.add('no-nav'); Views.renderQuoteForm(null); break;
      case 'edit':   document.getElementById('app').classList.add('no-nav'); Views.renderQuoteForm(param); break;
      case 'quote':  Views.renderQuoteDetail(param); break;
      case 'catalog':Views.renderCatalog(); break;
      case 'settings':Views.renderSettings(); break;
      default:       Views.renderDashboard();
    }
    window.scrollTo(0, 0);
  },
  start() {
    window.addEventListener('hashchange', () => this.render());
    this.render();
  }
};

/* ---------- LAYOUT ---------- */
const Layout = {
  header(title, subtitle, showBack) {
    return `<header class="app-header">
      <div class="brand">
        ${showBack ? `<button class="header-back" onclick="history.back()" aria-label="Vissza">${Icons.back}</button>` : `<div class="brand-mark">${Icons.docCheck}</div>`}
        <div class="brand-text" style="${showBack ? 'padding-left:44px' : ''}">
          <h1>${Utils.escapeHtml(title)}</h1>
          ${subtitle ? `<p>${Utils.escapeHtml(subtitle)}</p>` : ''}
        </div>
      </div>
    </header>`;
  },
  nav(active) {
    const items = [
      { id: 'dashboard', label: 'Árajánlatok', icon: Icons.list, hash: '#/' },
      { id: 'catalog',   label: 'Katalógus',   icon: Icons.folder, hash: '#/catalog' },
      { id: 'settings',  label: 'Beállítások', icon: Icons.gear, hash: '#/settings' }
    ];
    return `<nav class="bottom-nav">
      ${items.map(it => `<a href="${it.hash}" class="nav-item ${active === it.id ? 'active' : ''}" onclick="Utils.vibrate()">
        ${it.icon}<span>${it.label}</span>
      </a>`).join('')}
    </nav>`;
  }
};

/* ---------- SPEECH RECOGNITION ---------- */
let recognition = null;
if (window.SpeechRecognition || window.webkitSpeechRecognition) {
  const Speech = window.SpeechRecognition || window.webkitSpeechRecognition;
  recognition = new Speech();
  recognition.lang = 'hu-HU';
  recognition.interimResults = false;
  recognition.maxAlternatives = 1;
}

/* ---------- VIEWS ---------- */
const Views = {

  /* ===== DASHBOARD ===== */
  renderDashboard() {
    const quotes = [...Store.quotes].sort((a, b) => new Date(b.createdAt) - new Date(a.createdAt));
    const accepted = quotes.filter(q => q.status === 'accepted');
    const totalAccepted = accepted.reduce((s, q) => s + Utils.calcTotals(q.items, q.vatRate).gross, 0);
    const pending = quotes.filter(q => q.status === 'pending').length;
    
    // Reminder logic (3 days)
    const now = new Date();
    const oldPending = quotes.filter(q => q.status === 'pending' && (now - new Date(q.createdAt)) > 3 * 24 * 60 * 60 * 1000);

    let listHtml;
    if (quotes.length === 0) {
      listHtml = `<div class="empty fade-in">
        <div class="empty-icon">${Icons.docCheck}</div>
        <h3>Még nincs árajánlatod</h3>
        <p>Koppints a + gombra, és 60 másodperc alatt kész az első árajánlatod.</p>
      </div>`;
    } else {
      listHtml = `<div class="quote-list fade-in">${quotes.map(q => {
        const t = Utils.calcTotals(q.items, q.vatRate);
        const cls = q.status === 'accepted' ? 'is-accepted' : q.status === 'declined' ? 'is-declined' : '';
        const pill = q.status === 'accepted' ? 'pill-accepted' : q.status === 'declined' ? 'pill-declined' : 'pill-pending';
        const label = q.status === 'accepted' ? 'Elfogadva' : q.status === 'declined' ? 'Elutasítva' : 'Függő';
        return `<div class="quote-item ${cls}" onclick="Utils.vibrate(); Router.navigate('#/quote/${q.id}')">
          <div class="avatar">${Utils.escapeHtml(Utils.initials(q.clientName))}</div>
          <div class="quote-body">
            <div class="quote-name">${Utils.escapeHtml(q.clientName || 'Névtelen')}</div>
            <div class="quote-sub"><span class="pill ${pill}">${label}</span><span>${q.number}</span></div>
          </div>
          <div class="quote-amount">${Utils.formatHuf(t.gross)}</div>
        </div>`;
      }).join('')}</div>`;
    }

    document.getElementById('app').innerHTML = `
      ${Layout.header('Árajánlat', 'Szakmunkás árajánlat 60 másodperc alatt')}
      <div class="container">
        ${oldPending.length > 0 ? `
          <div class="reminder-banner">
            ${Icons.alert}
            <div>
              <strong>Figyelem!</strong> ${oldPending.length} db árajánlat több mint 3 napja függőben van. Érdemes rákérdezni az ügyfélnél.
            </div>
          </div>
        ` : ''}
        ${quotes.length > 0 ? `<div class="hero fade-in">
          <div class="hero-inner">
            <div class="hero-label">Elfogadott árajánlatok értéke</div>
            <div class="hero-value">${Utils.formatHuf(totalAccepted)}</div>
            <div class="hero-meta">
              <span><b>${accepted.length}</b> elfogadva</span>
              <span><b>${pending}</b> függő</span>
              <span><b>${quotes.length}</b> összesen</span>
            </div>
          </div>
        </div>` : ''}
        <div class="section-label">Árajánlataim</div>
        ${listHtml}
      </div>
      <button class="fab" onclick="Utils.vibrate(); Router.navigate('#/new')" aria-label="Új árajánlat">${Icons.plus}</button>
      ${Layout.nav('dashboard')}
    `;
  },

  /* ===== QUOTE FORM ===== */
  renderQuoteForm(editId) {
    let quote = null;
    if (editId) {
      quote = Store.quotes.find(q => q.id === editId);
      if (!quote) { Router.navigate('#/'); return; }
    }
    window.__formState = quote ? JSON.parse(JSON.stringify(quote)) : {
      id: null, number: null,
      clientName: '', clientPhone: '', clientEmail: '', clientAddress: '',
      note: '', items: [], vatRate: Store.settings.defaultVat,
      status: 'pending', createdAt: null
    };
    this._renderFormInner();
  },

  _renderFormInner() {
    const s = window.__formState;
    const isEdit = !!s.id;
    const catalog = Store.catalog;
    const t = Utils.calcTotals(s.items, s.vatRate);
    const recentClients = Utils.getRecentClients();

    const itemsHtml = s.items.length === 0
      ? `<div style="text-align:center;padding:20px 12px;color:var(--muted);font-size:.85rem;">Még nincs tétel.<br>Válassz a katalógusból, vagy adj hozzá egyedit.</div>`
      : s.items.map((it, i) => `
          <div class="line">
            ${it.image ? `<img src="${it.image}" class="line-img">` : ''}
            <div class="line-body">
              <div class="line-name">${Utils.escapeHtml(it.name)}</div>
              <div class="line-meta">${Utils.formatHuf(it.unitPrice)} / ${Utils.escapeHtml(it.unit)}</div>
            </div>
            <div class="qty">
              <button onclick="Views.changeQty(${i},-1)" aria-label="Kevesebb">−</button>
              <span>${it.qty}</span>
              <button onclick="Views.changeQty(${i},1)" aria-label="Több">+</button>
            </div>
            <div class="line-price">${Utils.formatHuf(it.qty * it.unitPrice)}</div>
            <button class="line-remove" onclick="Views.removeItem(${i})" aria-label="Törlés">${Icons.x}</button>
          </div>
        `).join('');

    const catalogHtml = catalog.map(c => `
